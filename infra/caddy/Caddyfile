{
	email {$ACME_EMAIL}
	log default {
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
					replace code REDACTED
					replace state REDACTED
				}
				request>headers>Referer delete
			}
		}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()"
		Content-Security-Policy "base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}
}

(site_security_headers) {
	@allowed_frame_ancestor {
		header_regexp Referer ^https?://([^/]+\.)?(artmate\.ru|art-mate\.ru|webvisor\.com|metri[ck]a\.yandex\.(com|ru|by|com\.tr))/
	}
	@blocked_frame_ancestor {
		not {
			header_regexp Referer ^https?://([^/]+\.)?(artmate\.ru|art-mate\.ru|webvisor\.com|metri[ck]a\.yandex\.(com|ru|by|com\.tr))/
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()"
		-Server
	}
	header @allowed_frame_ancestor Content-Security-Policy "base-uri 'self'; frame-ancestors 'self' http://artmate.ru https://artmate.ru http://www.artmate.ru https://www.artmate.ru http://*.artmate.ru https://*.artmate.ru http://art-mate.ru https://art-mate.ru http://www.art-mate.ru https://www.art-mate.ru http://*.art-mate.ru https://*.art-mate.ru http://webvisor.com https://webvisor.com http://*.webvisor.com https://*.webvisor.com http://metrika.yandex.ru https://metrika.yandex.ru http://metrika.yandex.by https://metrika.yandex.by http://metrica.yandex.com https://metrica.yandex.com http://metrica.yandex.com.tr https://metrica.yandex.com.tr; object-src 'none'; upgrade-insecure-requests"
	header @blocked_frame_ancestor {
		X-Frame-Options "DENY"
		Content-Security-Policy "base-uri 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
	}
}

(auth_link_headers) {
	header {args[0]} {
		Referrer-Policy "no-referrer"
		Cache-Control "no-store, max-age=0"
		defer
	}
}

(proxy_headers) {
	header_up X-Forwarded-For {remote_host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-Proto {scheme}
	header_up X-Forwarded-Host {host}
}

art-mate.ru, www.art-mate.ru, www.artmate.ru {
	import site_security_headers
	@sensitive_auth path /auth/activate-order /auth/reset-password /auth/oauth/* /unsubscribe /consents/email-advertising/unsubscribe /consents/email-advertising/unsubscribe/*
	import auth_link_headers @sensitive_auth
	handle_errors {
		import auth_link_headers @sensitive_auth
		respond "" {err.status_code}
	}
	redir https://artmate.ru{uri} permanent
}

artmate.ru {
	import site_security_headers
	@sensitive_auth path /auth/activate-order /auth/reset-password /auth/oauth/* /unsubscribe /consents/email-advertising/unsubscribe /consents/email-advertising/unsubscribe/*
	import auth_link_headers @sensitive_auth
	handle_errors {
		import auth_link_headers @sensitive_auth
		respond "" {err.status_code}
	}
	encode zstd gzip
	reverse_proxy site:3000 {
		import proxy_headers
	}
}

admin.art-mate.ru {
	import security_headers
	redir https://admin.artmate.ru{uri} permanent
}

admin.artmate.ru {
	import security_headers
	encode zstd gzip
	reverse_proxy admin:3003 {
		import proxy_headers
	}
}

affiliate.artmate.ru {
	import security_headers
	header X-Robots-Tag "noindex, nofollow, noarchive"
	encode zstd gzip
	reverse_proxy affiliate:3006 {
		import proxy_headers
	}
}

