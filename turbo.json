{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ADMIN_URL",
    "API_BASE_URL",
    "API_PUBLIC_URL",
    "AUTH_JWT_SECRET",
    "AUTH_EMAIL_VERIFICATION_CODE_TTL_SECONDS",
    "AUTH_EMAIL_VERIFICATION_IP_MAX_SENDS_PER_HOUR",
    "AUTH_EMAIL_VERIFICATION_MAX_ATTEMPTS",
    "AUTH_EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR",
    "AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS",
    "AUTH_EMAIL_VERIFICATION_SECRET",
    "AUTH_PASSWORD",
    "AUTH_PASSWORD_EMAIL",
    "AUTH_PASSWORD_HASH",
    "AUTH_PASSWORD_LOGIN",
    "AUTH_PASSWORD_NAME",
    "AUTH_PASSWORD_ROLES",
    "AUTH_SUCCESS_REDIRECT_URL",
    "CORS_ORIGIN",
    "CONTENT_ASSISTANT_DEFAULT_BLOG_AUTHOR_ID",
    "CONTENT_ASSISTANT_DEFAULT_BLOG_CATEGORY_ID",
    "CONTENT_ASSISTANT_TELEGRAM_APPROVAL_CHAT_ID",
    "CONTENT_ASSISTANT_TELEGRAM_BOT_TOKEN",
    "CONTENT_ASSISTANT_TELEGRAM_WEBHOOK_SECRET",
    "DATABASE_URL",
    "MAIL_FROM",
    "MAIL_LOG_ONLY",
    "MAIL_REPLY_TO",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "OPENAI_MODEL",
    "OPENAI_RELAY_TOKEN",
    "OPENAI_ORGANIZATION",
    "OPENAI_PROJECT",
    "UNSPLASH_ACCESS_KEY",
    "UNSPLASH_UTM_SOURCE",
    "AI_RELAY_TOKEN",
    "OZON_API",
    "OZON_LOGISTICS_MODE",
    "OZON_OAUTH_ACCESS_TYPE",
    "OZON_OAUTH_CLIENT_ID",
    "OZON_OAUTH_CLIENT_SECRET",
    "OZON_OAUTH_PROMPT",
    "OZON_OAUTH_REDIRECT_URI",
    "OZON_OAUTH_REFRESH_TOKEN",
    "OZON_OAUTH_SCOPE",
    "PORT",
    "SITE_URL",
    "SMTP_HOST",
    "SMTP_PASSWORD",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SWAGGER_ENABLED",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CONTACTS_CHAT_ID",
    "TELEGRAM_ORDERS_CHAT_ID",
    "YANDEX_OAUTH_CLIENT_ID",
    "YANDEX_OAUTH_CLIENT_SECRET",
    "YANDEX_OAUTH_REDIRECT_URI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
