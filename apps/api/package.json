{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "ts-node src/main.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "backfill:coloring-cards": "ts-node src/colorings/backfill-coloring-cards.ts",
    "import:ozon-products": "ts-node src/products/import-ozon-products.ts",
    "seed:blog-mocks": "ts-node src/blog/seed-blog-mocks.ts",
    "start": "node dist/main.js",
    "pretest": "prisma generate",
    "test": "node --test --test-concurrency=1 --require ts-node/register test/*.spec.ts",
    "check-types:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint --max-warnings 0",
    "precheck-types": "prisma generate",
    "check-types": "tsc --noEmit",
    "prisma": "prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "mustache": "^4.2.0",
    "nodemailer": "^8.0.10",
    "openai": "^6.42.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.4",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.1",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.1",
    "globals": "^17.6.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  }
}
