enum CustomerProfileCommandStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")
  REJECTED  @map("rejected")

  @@map("customer_profile_command_status")
}

// Users publishes the current profile; Auth reads this contract, never User
// internals. Phone is a contact field, not an SMS verification fact.
model CustomerProfileState {
  userId          String     @id @map("user_id")
  contractVersion Int        @default(1) @map("contract_version")
  revision        Int
  email           String?    @unique @db.VarChar(320)
  name            String?    @db.VarChar(120)
  phone           String?    @db.VarChar(80)
  status          UserStatus
  authVersion     Int        @map("auth_version")
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profile_states")
}

// Auth enqueues immutable intent; Users alone applies it and stores its result
// in the same transaction as the profile. operationId is the inbox dedupe key.
model EnsureCustomerProfileCommand {
  id                      String                       @id @default(cuid())
  contractVersion         Int                          @default(1) @map("contract_version")
  operationId             String                       @unique @map("operation_id")
  identityFactId          String                       @map("identity_fact_id")
  expectedUserId          String?                      @map("expected_user_id")
  expectedProfileRevision Int?                         @map("expected_profile_revision")
  name                    String                       @db.VarChar(120)
  phone                   String                       @db.VarChar(80)
  payloadHash             String                       @map("payload_hash") @db.Char(64)
  status                  CustomerProfileCommandStatus @default(PENDING)
  attempts                Int                          @default(0)
  leaseToken              String?                      @map("lease_token") @db.Uuid
  lockedUntil             DateTime?                    @map("locked_until")
  availableAt             DateTime                     @default(now()) @map("available_at")
  resultUserId            String?                      @map("result_user_id")
  resultProfileRevision   Int?                         @map("result_profile_revision")
  errorCode               String?                      @map("error_code") @db.VarChar(80)
  processedAt             DateTime?                    @map("processed_at")
  createdAt               DateTime                     @default(now()) @map("created_at")
  operation               AuthCompletionOperation      @relation(fields: [operationId, identityFactId], references: [id, identityFactId], onDelete: Restrict)

  @@unique([operationId, identityFactId])
  @@index([status, availableAt])
  @@map("ensure_customer_profile_commands")
}
