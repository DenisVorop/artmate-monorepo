model OzonOAuthToken {
  id           String   @id @default(cuid())
  tokenKey     String   @unique @default("default") @map("token_key") @db.VarChar(64)
  accessToken  String   @map("access_token") @db.Text
  refreshToken String?  @map("refresh_token") @db.Text
  scope        String[] @default([])
  tokenType    String?  @map("token_type") @db.VarChar(32)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("ozon_oauth_tokens")
}

model DeliveryCacheEntry {
  key         String    @id @db.VarChar(200)
  payload     Json?
  byteSize    Int       @default(0) @map("byte_size")
  refreshedAt DateTime? @map("refreshed_at")
  freshUntil  DateTime? @map("fresh_until")
  expiresAt   DateTime? @map("expires_at")
  leaseToken  String?   @map("lease_token") @db.Uuid
  leaseUntil  DateTime? @map("lease_until")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@index([refreshedAt])
  @@map("delivery_cache_entries")
}

model NominatimRateLimit {
  key           String   @id @db.VarChar(32)
  nextAllowedAt DateTime @map("next_allowed_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("nominatim_rate_limits")
}
