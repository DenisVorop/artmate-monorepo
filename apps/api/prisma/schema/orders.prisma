enum OrderStatus {
  PENDING_PAYMENT @map("pending_payment")
  PAID            @map("paid")

  @@map("order_status")
}

enum OrderPaymentMethod {
  BANK_CARD_MOCK @map("bank_card_mock")

  @@map("order_payment_method")
}

enum OrderPaymentStatus {
  PENDING @map("pending")
  PAID    @map("paid")

  @@map("order_payment_status")
}

enum OrderDeliveryProvider {
  OZON @map("ozon")

  @@map("order_delivery_provider")
}

model Order {
  id                   String                @id @db.VarChar(32)
  userId               String?               @map("user_id")
  cartId               String                @map("cart_id") @db.VarChar(128)
  status               OrderStatus           @default(PENDING_PAYMENT)
  customerName         String                @map("customer_name") @db.VarChar(160)
  customerPhone        String                @map("customer_phone") @db.VarChar(80)
  customerEmail        String                @map("customer_email") @db.VarChar(320)
  deliveryProvider     OrderDeliveryProvider @default(OZON) @map("delivery_provider")
  pickupPointId        String                @map("pickup_point_id") @db.VarChar(160)
  pickupPointTitle     String                @map("pickup_point_title") @db.VarChar(180)
  pickupPointAddress   String                @map("pickup_point_address") @db.Text
  pickupPointWorkHours String                @map("pickup_point_work_hours") @db.VarChar(120)
  deliveryPrice        Decimal               @map("delivery_price") @db.Decimal(12, 2)
  paymentMethod        OrderPaymentMethod    @default(BANK_CARD_MOCK) @map("payment_method")
  paymentStatus        OrderPaymentStatus    @default(PENDING) @map("payment_status")
  paymentRedirectUrl   String                @map("payment_redirect_url") @db.Text
  itemsCount           Int                   @map("items_count")
  subtotal             Decimal               @db.Decimal(12, 2)
  total                Decimal               @db.Decimal(12, 2)
  currency             String                @default("RUB") @db.VarChar(3)
  comment              String?               @db.Text
  paidAt               DateTime?             @map("paid_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at")

  items OrderItem[]
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([cartId])
  @@index([status, createdAt])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  orderId      String   @map("order_id") @db.VarChar(32)
  productId    String   @map("product_id") @db.VarChar(191)
  title        String   @db.VarChar(220)
  slug         String   @db.VarChar(180)
  price        Decimal  @db.Decimal(12, 2)
  category     String?  @db.VarChar(120)
  categorySlug String?  @map("category_slug") @db.VarChar(160)
  image        String   @db.Text
  quantity     Int
  lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, productId])
  @@index([productId])
  @@map("order_items")
}
