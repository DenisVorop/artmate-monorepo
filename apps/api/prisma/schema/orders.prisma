enum OrderStatus {
  PENDING_PAYMENT @map("pending_payment")
  PAID            @map("paid")

  @@map("order_status")
}

enum OrderPaymentMethod {
  BANK_CARD_MOCK @map("bank_card_mock")
  OZON_ACQUIRING @map("ozon_acquiring")
  TBANK_ACQUIRING @map("tbank_acquiring")

  @@map("order_payment_method")
}

enum OrderPaymentStatus {
  PENDING @map("pending")
  PAID    @map("paid")
  FAILED  @map("failed")

  @@map("order_payment_status")
}

enum OrderCrmStatus {
  NEW             @map("new")
  IN_PROGRESS     @map("in_progress")
  WAITING_PAYMENT @map("waiting_payment")
  PAID            @map("paid")
  DELIVERING      @map("delivering")
  COMPLETED       @map("completed")
  CANCELLED       @map("cancelled")

  @@map("order_crm_status")
}

enum OrderDeliveryProvider {
  CDEK @map("cdek")
  OZON @map("ozon")

  @@map("order_delivery_provider")
}

model Order {
  id                          String                @id @db.VarChar(32)
  userId                      String?               @map("user_id")
  cartId                      String                @map("cart_id") @db.VarChar(128)
  status                      OrderStatus           @default(PENDING_PAYMENT)
  crmStatus                   OrderCrmStatus        @default(NEW) @map("crm_status")
  customerName                String                @map("customer_name") @db.VarChar(160)
  customerPhone               String                @map("customer_phone") @db.VarChar(80)
  customerEmail               String                @map("customer_email") @db.VarChar(320)
  deliveryProvider            OrderDeliveryProvider @default(OZON) @map("delivery_provider")
  pickupPointId               String                @map("pickup_point_id") @db.VarChar(160)
  pickupPointTitle            String                @map("pickup_point_title") @db.VarChar(180)
  pickupPointAddress          String                @map("pickup_point_address") @db.Text
  pickupPointWorkHours        String                @map("pickup_point_work_hours") @db.VarChar(120)
  deliveryPrice               Decimal               @map("delivery_price") @db.Decimal(12, 2)
  paymentMethod               OrderPaymentMethod    @default(BANK_CARD_MOCK) @map("payment_method")
  paymentStatus               OrderPaymentStatus    @default(PENDING) @map("payment_status")
  paymentRedirectUrl          String                @map("payment_redirect_url") @db.Text
  ozonAcquiringOrderId        String?               @map("ozon_acquiring_order_id") @db.VarChar(120)
  ozonAcquiringPaymentId      String?               @map("ozon_acquiring_payment_id") @db.VarChar(120)
  ozonAcquiringTransactionId  String?               @map("ozon_acquiring_transaction_id") @db.VarChar(120)
  ozonAcquiringTransactionUid String?               @map("ozon_acquiring_transaction_uid") @db.VarChar(120)
  tbankAcquiringOrderId       String?               @map("tbank_acquiring_order_id") @db.VarChar(36)
  tbankAcquiringPaymentId     String?               @map("tbank_acquiring_payment_id") @db.VarChar(20)
  paymentErrorCode            String?               @map("payment_error_code") @db.VarChar(120)
  paymentErrorMessage         String?               @map("payment_error_message") @db.Text
  lastPaymentNotification     Json?                 @map("last_payment_notification") @db.JsonB
  itemsCount                  Int                   @map("items_count")
  subtotal                    Decimal               @db.Decimal(12, 2)
  total                       Decimal               @db.Decimal(12, 2)
  currency                    String                @default("RUB") @db.VarChar(3)
  comment                     String?               @db.Text
  paidAt                      DateTime?             @map("paid_at")
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @default(now()) @updatedAt @map("updated_at")

  adminComments OrderAdminComment[]
  items         OrderItem[]
  shipments     OrderShipment[]
  history       OrderHistory[]
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([cartId])
  @@index([status, createdAt])
  @@index([crmStatus, createdAt])
  @@index([customerEmail])
  @@index([ozonAcquiringOrderId])
  @@index([ozonAcquiringPaymentId])
  @@index([tbankAcquiringOrderId])
  @@index([tbankAcquiringPaymentId])
  @@map("orders")
}

model OrderShipment {
  id             String                @id @default(cuid())
  orderId        String                @map("order_id") @db.VarChar(32)
  provider       OrderDeliveryProvider
  externalUuid   String?               @map("external_uuid") @db.VarChar(120)
  externalNumber String?               @map("external_number") @db.VarChar(120)
  requestUuid    String?               @map("request_uuid") @db.VarChar(120)
  requestState   String?               @map("request_state") @db.VarChar(40)
  statusCode     String?               @map("status_code") @db.VarChar(80)
  statusName     String?               @map("status_name") @db.VarChar(160)
  errorMessage   String?               @map("error_message") @db.Text
  requestPayload Json?                 @map("request_payload") @db.JsonB
  responsePayload Json?                @map("response_payload") @db.JsonB
  syncedAt       DateTime?             @map("synced_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, provider])
  @@index([provider, requestState])
  @@index([externalUuid])
  @@map("order_shipments")
}

model OrderItem {
  orderId      String   @map("order_id") @db.VarChar(32)
  productId    String   @map("product_id") @db.VarChar(191)
  title        String   @db.VarChar(220)
  slug         String   @db.VarChar(180)
  price        Decimal  @db.Decimal(12, 2)
  category     String?  @db.VarChar(120)
  categorySlug String?  @map("category_slug") @db.VarChar(160)
  image        String   @db.Text
  quantity     Int
  lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

model OrderAdminComment {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id") @db.VarChar(32)
  authorId  String?  @map("author_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  author User? @relation("OrderAdminCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([authorId])
  @@map("order_admin_comments")
}

model OrderHistory {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id") @db.VarChar(32)
  authorId  String?  @map("author_id")
  eventType String   @map("event_type") @db.VarChar(80)
  payload   Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  author User? @relation("OrderHistoryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([authorId])
  @@index([eventType])
  @@map("order_history")
}
