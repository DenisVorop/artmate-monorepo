model Cart {
  id        String   @id @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
}

model CartItem {
  cartId       String   @map("cart_id") @db.VarChar(128)
  productId    String   @map("product_id") @db.VarChar(191)
  title        String   @db.VarChar(220)
  slug         String   @db.VarChar(180)
  price        Decimal  @db.Decimal(12, 2)
  category     String   @db.VarChar(120)
  categorySlug String   @map("category_slug") @db.VarChar(160)
  image        String   @db.Text
  quantity     Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@id([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}
