enum UserStatus {
  ACTIVE  @map("active")
  BLOCKED @map("blocked")
  DELETED @map("deleted")

  @@map("user_status")
}

enum UserRole {
  CUSTOMER @map("customer")
  ADMIN    @map("admin")

  @@map("user_role")
}

model User {
  id              String     @id @default(cuid())
  email           String?    @unique @db.VarChar(320)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  name            String?    @db.VarChar(120)
  phone           String?    @db.VarChar(80)
  image           String?    @db.Text
  roles           UserRole[] @default([CUSTOMER])
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  authAccounts             AuthAccount[]
  authSessions             AuthSession[]
  emailVerificationCodes   AuthEmailVerificationCode[]
  passwordResetTokens      AuthPasswordResetToken[]
  telegramAccount          TelegramAccount?
  aiBlogDraftRuns          AiBlogDraftRun[]            @relation("AiBlogDraftRunCreator")
  createdBlogPosts         BlogPost[]                  @relation("BlogPostCreator")
  orderAdminComments       OrderAdminComment[]         @relation("OrderAdminCommentAuthor")
  orderHistory             OrderHistory[]              @relation("OrderHistoryAuthor")
  orders                   Order[]
  createdColoringRevisions ColoringRevision[]          @relation("ColoringRevisionCreator")
  coloringRevisionReviews  ColoringRevisionReview[]    @relation("ColoringRevisionReviewer")
  publishedColorings       Coloring[]                  @relation("ColoringPublisher")

  @@index([status])
  @@map("users")
}
