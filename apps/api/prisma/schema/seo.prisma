enum SeoEntryStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("seo_entry_status")
}

enum SeoSnapshotKind {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("seo_snapshot_kind")
}

model SeoEntry {
  id                  String         @id @default(cuid()) @db.VarChar(32)
  path                String         @unique @db.VarChar(2048)
  source              Json?
  status              SeoEntryStatus @default(DRAFT)
  draftSnapshotId     String?        @map("draft_snapshot_id") @db.VarChar(32)
  publishedSnapshotId String?        @map("published_snapshot_id") @db.VarChar(32)
  createdById         String?        @map("created_by_id") @db.VarChar(32)
  updatedById         String?        @map("updated_by_id") @db.VarChar(32)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at")

  snapshots SeoSnapshot[]

  @@index([status, updatedAt])
  @@map("seo_entries")
}

model SeoSnapshot {
  id          String          @id @default(cuid()) @db.VarChar(32)
  entryId     String          @map("entry_id") @db.VarChar(32)
  version     Int
  kind        SeoSnapshotKind @default(DRAFT)
  payload     Json
  comment     String?         @db.VarChar(500)
  createdById String?         @map("created_by_id") @db.VarChar(32)
  publishedAt DateTime?       @map("published_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  entry SeoEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, version])
  @@index([entryId, createdAt])
  @@index([kind, createdAt])
  @@map("seo_snapshots")
}
