enum LoyaltyAchievementConditionKind {
  published_coloring_count
  distinct_collection_count
  completed_collection_count
  completed_order_count

  @@map("loyalty_achievement_condition_kind")
}

// Editing advances currentVersion; only explicit activation advances activeVersion.
model LoyaltyAchievementDefinition {
  id              String    @id @default(uuid()) @db.Uuid
  currentVersion  Int       @default(1) @map("current_version")
  activeVersion   Int?      @map("active_version")
  activatedAt     DateTime? @map("activated_at")
  activatedById   String?   @map("activated_by_id")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  revisions       LoyaltyAchievementRevision[] @relation("AchievementRevisions")
  currentRevision LoyaltyAchievementRevision @relation("AchievementCurrentRevision", fields: [id, currentVersion], references: [definitionId, version], onDelete: Restrict, onUpdate: NoAction)
  activeRevision LoyaltyAchievementRevision? @relation("AchievementActiveRevision", fields: [id, activeVersion], references: [definitionId, version], onDelete: Restrict, onUpdate: Restrict)
  activatedBy User? @relation("AchievementActivator", fields: [activatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  awards LoyaltyAchievementAward[]

  @@unique([id, currentVersion])
  @@unique([id, activeVersion])
  @@index([activatedById])
  @@map("loyalty_achievement_definitions")
}

model LoyaltyAchievementRevision {
  definitionId  String                          @map("definition_id") @db.Uuid
  version       Int
  title         String                          @db.VarChar(120)
  description   String                          @db.VarChar(1000)
  imageUrl      String?                         @map("image_url") @db.Text
  conditionKind LoyaltyAchievementConditionKind @map("condition_kind")
  target        Int
  rewardPoints  Int                             @map("reward_points")
  sortOrder     Int                             @map("sort_order")
  createdById   String                          @map("created_by_id")
  createdAt     DateTime                        @default(now()) @map("created_at")
  definition    LoyaltyAchievementDefinition    @relation("AchievementRevisions", fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentFor    LoyaltyAchievementDefinition?   @relation("AchievementCurrentRevision")
  activeFor     LoyaltyAchievementDefinition?   @relation("AchievementActiveRevision")
  awards        LoyaltyAchievementAward[]
  createdBy     User                            @relation("AchievementRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([definitionId, version])
  @@index([createdById])
  @@map("loyalty_achievement_revisions")
}

model LoyaltyAchievementAward {
  id                String   @id @default(uuid())
  memberId          String   @map("member_id")
  definitionId      String   @map("definition_id") @db.Uuid
  revisionVersion   Int      @map("revision_version")
  publicationFactId String?  @map("publication_fact_id")
  completionOrderId String?  @map("completion_order_id") @db.VarChar(32)
  completionCollectionId String? @map("completion_collection_id") @db.VarChar(32)
  points            Int
  qualifiedAt       DateTime @map("qualified_at")
  awardedAt         DateTime @default(dbgenerated("(CURRENT_TIMESTAMP(3) AT TIME ZONE 'UTC')")) @map("awarded_at")

  member          LoyaltyMember                @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  definition      LoyaltyAchievementDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision        LoyaltyAchievementRevision   @relation(fields: [definitionId, revisionVersion], references: [definitionId, version], onDelete: Restrict, onUpdate: Restrict)
  publicationFact WorkshopPublicationFact?      @relation(fields: [publicationFactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  completionOrder OrderCompletionFact? @relation(fields: [completionOrderId], references: [orderId], onDelete: Restrict, onUpdate: Restrict)
  completionManifest ColoringCollectionManifest? @relation(fields: [completionCollectionId], references: [collectionId], onDelete: Restrict, onUpdate: Restrict)
  operation       LoyaltyOperation?

  @@unique([memberId, definitionId])
  @@index([definitionId, revisionVersion])
  @@index([publicationFactId])
  @@index([completionCollectionId])
  @@index([completionOrderId])
  @@map("loyalty_achievement_awards")
}

model LoyaltyAchievementSync {
  memberId      String   @id @map("member_id")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  lastError     String?  @map("last_error") @db.VarChar(80)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  member LoyaltyMember @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([nextAttemptAt])
  @@map("loyalty_achievement_syncs")
}
